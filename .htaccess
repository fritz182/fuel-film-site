# Settings for Hostinger web hosting (Apache / LiteSpeed)

# Always use https and the address without www
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://fuel-film.com/$1 [R=301,L]

# Old Framer addresses -> new pages (keeps Google ranking and old links working)
RewriteRule ^film-and-edit/?$ /#archive [R=301,NE,L]
RewriteRule ^3d-animation/?$ /#archive [R=301,NE,L]
RewriteRule ^about/?$ /#about [R=301,NE,L]
RewriteRule ^podcasts/?$ /production.html#podcasts [R=301,NE,L]
RewriteRule ^production/?$ /production.html [R=301,L]

ErrorDocument 404 /404.html

# Keep this folder's notes private
<Files "README.md">
  Require all denied
</Files>

# Let browsers cache images and fonts for a month
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
